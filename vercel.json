{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend/",
      "framework": "express"
    },
    "frontend": {
      "root": "frontend/",
      "framework": "vite",
      "routes": [
        {
          "src": "/[^.]+",
          "dest": "/",
          "status": 200
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
